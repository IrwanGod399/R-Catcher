<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreSentinel | Ransomware Honeyfile Defense Dashboard" Height="700" Width="1120"
        WindowStartupLocation="CenterScreen" Background="#0E0F12" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#1A1C24"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#2A2D3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBtn" BasedOn="{StaticResource IconBtn}" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>

        <Style x:Key="StopBtn" BasedOn="{StaticResource IconBtn}" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Metric Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="C O R E S E N T I N E L" FontSize="18" FontWeight="Black" Foreground="#38BDF8"/>
                <TextBlock Text="Kernel Honeyfile Defense &amp; Real-Time Execution Guard" FontSize="11" Foreground="#64748B"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#14161F" CornerRadius="8" Padding="12,8" Margin="5,0" BorderBrush="#202433" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="BLOCKED PROCESSES" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblBlockedCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#14161F" CornerRadius="8" Padding="12,8" Margin="5,0" BorderBrush="#202433" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="HONEYFILE STATUS" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblBaitStatus" Text="Not Deployed" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#14161F" CornerRadius="8" Padding="12,8" Margin="5,0" BorderBrush="#202433" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL I/O INTERCEPT" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblEventCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Controls & Search Filter -->
        <Border Grid.Row="1" Background="#14161F" CornerRadius="8" Padding="8" Margin="0,0,0,12" BorderBrush="#202433" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnLoad" Content="⚙" ToolTip="Load Minispy Minifilter Driver" Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="btnLoad_Click"/>
                    <Button x:Name="btnDeploy" Content="📁" ToolTip="Deploy Bait Honeyfiles (C:\Honey)" Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="btnDeploy_Click"/>
                    <Button x:Name="btnCleanBait" Content="🧹" ToolTip="Clear Kernel Targets &amp; Delete Bait Files" Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="btnCleanBait_Click"/>
                    <Button x:Name="btnStart" Content="▶" ToolTip="Start Real-time Interception" Style="{StaticResource PlayBtn}" Margin="0,0,6,0" Click="btnStart_Click"/>
                    <Button x:Name="btnStop" Content="⏹" ToolTip="Stop Monitoring" Style="{StaticResource StopBtn}" Margin="0,0,6,0" IsEnabled="False" Click="btnStop_Click"/>
                    <Button x:Name="btnClear" Content="🗑" ToolTip="Clear Logs Table" Style="{StaticResource IconBtn}" Margin="0,0,6,0" Click="btnClear_Click"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="24" Fill="#24283B" Margin="4,0,12,0"/>

                <Border Grid.Column="2" Background="#1A1D29" CornerRadius="6" Height="38">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtFilter" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                 Foreground="#FAFAFA" VerticalContentAlignment="Center" FontSize="12" 
                                 CaretBrush="#FFFFFF" TextChanged="txtFilter_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Logs DataGrid (Hanya menampilkan kolom yang relevan) -->
        <Border Grid.Row="2" Background="#14161F" CornerRadius="8" BorderBrush="#202433" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgLogs" AutoGenerateColumns="False" 
                      Background="Transparent" RowBackground="#14161F" AlternatingRowBackground="#171A24"
                      Foreground="#E2E8F0" BorderThickness="0" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#202433"
                      IsReadOnly="True" RowHeight="34" FontSize="12">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1C1F2B"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#202433"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="105"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="75"/>
                    <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="170"/>
                    <DataGridTextColumn Header="Target Path" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Action Taken" Binding="{Binding ActionTaken}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Status Bar Bawah -->
        <Grid Grid.Row="3" Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="statusIndicator" Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0"/>
                <TextBlock x:Name="lblStatus" Text="Standby" Foreground="#64748B" FontSize="11"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Engine: minispy.exe | Bait: C:\Honey" Foreground="#475569" FontSize="11"/>
        </Grid>
    </Grid>
</Window>